# ============================================================
# NexusPay — Environment Configuration Template
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Django Core ────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-django-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# ─── Database ────────────────────────────────────────────────
DB_NAME=nexuspay
DB_USER=nexuspay_user
DB_PASSWORD=nexuspay_password
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ─── Exchange Rate Provider ───────────────────────────────────
COINGECKO_API_KEY=
CONVERSION_SPREAD_PERCENT=0.5
CONVERSION_FEE_PERCENT=0.1

# ─── OTP ─────────────────────────────────────────────────────
OTP_SIMULATION_MODE=True

# ─── QR Payment ──────────────────────────────────────────────
QR_HMAC_SECRET=your-qr-hmac-secret-key-change-in-production
QR_DEFAULT_EXPIRY_SECONDS=300

# ─── Blockchain Provider (Primary) ───────────────────────────
# Supported: alchemy, infura, quicknode, ankr, public
BLOCKCHAIN_PROVIDER_PRIMARY=public

# Alchemy (recommended for production)
ALCHEMY_API_KEY=
ALCHEMY_POLYGON_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/

# Infura (alternative)
INFURA_PROJECT_ID=
INFURA_POLYGON_AMOY_URL=https://polygon-amoy.infura.io/v3/

# QuickNode (alternative)
QUICKNODE_POLYGON_AMOY_URL=

# Ankr (alternative)
ANKR_POLYGON_AMOY_URL=https://rpc.ankr.com/polygon_amoy

# Public RPC Fallbacks (no key required — rate limited)
POLYGON_AMOY_RPC_PRIMARY=https://rpc-amoy.polygon.technology
POLYGON_AMOY_RPC_FALLBACK_1=https://polygon-amoy.public.blastapi.io
POLYGON_AMOY_RPC_FALLBACK_2=https://rpc.ankr.com/polygon_amoy

# ─── Blockchain Network ───────────────────────────────────────
BLOCKCHAIN_NETWORK=polygon_amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=3

# ─── Token Contracts ─────────────────────────────────────────
# Polygon Amoy testnet USDC contract
USDC_CONTRACT_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
USDC_TOKEN_DECIMALS=6
USDC_TOKEN_SYMBOL=USDC

# ─── Blockchain Indexer ───────────────────────────────────────
INDEXER_POLL_INTERVAL_SECONDS=15
INDEXER_MAX_BLOCK_RANGE=500
INDEXER_MAX_RETRIES=5

# ─── WalletConnect ────────────────────────────────────────────
# Get free project ID at: https://cloud.walletconnect.com
WALLETCONNECT_PROJECT_ID=demo-project-id-replace-in-production

# ─── Fraud + Risk Engine ─────────────────────────────────────
FRAUD_RAPID_PAYMENT_WINDOW_SECONDS=60
FRAUD_RAPID_PAYMENT_THRESHOLD=5
FRAUD_LARGE_TX_THRESHOLD_USDC=10000
FRAUD_VELOCITY_MULTIPLIER=3.0

# ─── Treasury ────────────────────────────────────────────────
TREASURY_SEED_ON_STARTUP=True

# ─── Razorpay (UPI / Card on-ramp) ──────────────────────────────────────────
# Get keys at: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
# Set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ─── On-chain Treasury ───────────────────────────────────────────────────────
# EVM private key of the treasury wallet that sends USDC to users on Polygon
# NEVER commit this — fund it with USDC + MATIC on Polygon Amoy (testnet)
TREASURY_PRIVATE_KEY=0xYOUR_TREASURY_PRIVATE_KEY_HERE

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for Razorpay callback redirect after payment
FRONTEND_URL=http://localhost

